# copy to .env and fill in — the client reads this file, the token is never printed
MCP_URL=https://your-mcp-server.example/mcp
MCP_TOKEN=            # value, or keep the name below and put the token there
MCP_TOKEN_VAR=MCP_TOKEN

# 02: ids for the example scenario (project tree + board cards)
PROJECT_ID=
BOARD_ID=

# 03: one tool call, repeated
ONE_TOOL=
ONE_ARGS={"example":"arg"}
N=5
# MCPORTER_CONFIG=./config/mcporter.json
# MCPORTER_SERVER=myserver

# 04: the same tool N times, sequential vs parallel
FAN_TOOL=
FAN_ARGS=[{"id":"1"},{"id":"2"}]
